{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "10362853550363075333"
    }
  },
  "parameters": {
    "project": {
      "type": "string",
      "defaultValue": "fpi",
      "minLength": 3,
      "maxLength": 8
    },
    "env": {
      "type": "string",
      "defaultValue": "dev",
      "allowedValues": [
        "dev",
        "test",
        "prod"
      ]
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "searchSku": {
      "type": "string",
      "defaultValue": "basic",
      "allowedValues": [
        "free",
        "basic",
        "standard"
      ]
    },
    "pgAdminUser": {
      "type": "string",
      "defaultValue": "pgadmin"
    },
    "pgAdminPassword": {
      "type": "securestring"
    },
    "myIp": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Your public IP, to allow local access to PostgreSQL. Leave empty to skip."
      }
    }
  },
  "variables": {
    "suffix": "[take(uniqueString(resourceGroup().id), 6)]",
    "tags": {
      "project": "[parameters('project')]",
      "env": "[parameters('env')]",
      "managedBy": "bicep"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[format('st{0}{1}{2}', parameters('project'), parameters('env'), variables('suffix'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": false,
        "supportsHttpsTrafficOnly": true
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', format('st{0}{1}{2}', parameters('project'), parameters('env'), variables('suffix')), 'default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', format('st{0}{1}{2}', parameters('project'), parameters('env'), variables('suffix')))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', format('st{0}{1}{2}', parameters('project'), parameters('env'), variables('suffix')), 'default', 'raw-documents')]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', format('st{0}{1}{2}', parameters('project'), parameters('env'), variables('suffix')), 'default')]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[format('kv-{0}-{1}-{2}', parameters('project'), parameters('env'), variables('suffix'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7
      }
    },
    {
      "type": "Microsoft.Search/searchServices",
      "apiVersion": "2023-11-01",
      "name": "[format('srch-{0}-{1}-{2}', parameters('project'), parameters('env'), variables('suffix'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "[parameters('searchSku')]"
      },
      "properties": {
        "replicaCount": 1,
        "partitionCount": 1,
        "hostingMode": "default"
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2023-05-01",
      "name": "[format('oai-{0}-{1}-{2}', parameters('project'), parameters('env'), variables('suffix'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "kind": "OpenAI",
      "sku": {
        "name": "F0"
      },
      "properties": {
        "customSubDomainName": "[format('oai-{0}-{1}-{2}', parameters('project'), parameters('env'), variables('suffix'))]",
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2023-12-01-preview",
      "name": "[format('pg-{0}-{1}-{2}', parameters('project'), parameters('env'), variables('suffix'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "Standard_B1ms",
        "tier": "Burstable"
      },
      "properties": {
        "version": "16",
        "administratorLogin": "[parameters('pgAdminUser')]",
        "administratorLoginPassword": "[parameters('pgAdminPassword')]",
        "storage": {
          "storageSizeGB": 32
        },
        "backup": {
          "backupRetentionDays": 7,
          "geoRedundantBackup": "Disabled"
        },
        "highAvailability": {
          "mode": "Disabled"
        }
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/databases",
      "apiVersion": "2023-12-01-preview",
      "name": "[format('{0}/{1}', format('pg-{0}-{1}-{2}', parameters('project'), parameters('env'), variables('suffix')), 'fpi')]",
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('pg-{0}-{1}-{2}', parameters('project'), parameters('env'), variables('suffix')))]"
      ]
    },
    {
      "condition": "[not(empty(parameters('myIp')))]",
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/firewallRules",
      "apiVersion": "2023-12-01-preview",
      "name": "[format('{0}/{1}', format('pg-{0}-{1}-{2}', parameters('project'), parameters('env'), variables('suffix')), 'allow-my-ip')]",
      "properties": {
        "startIpAddress": "[parameters('myIp')]",
        "endIpAddress": "[parameters('myIp')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('pg-{0}-{1}-{2}', parameters('project'), parameters('env'), variables('suffix')))]"
      ]
    }
  ],
  "outputs": {
    "storageAccountName": {
      "type": "string",
      "value": "[format('st{0}{1}{2}', parameters('project'), parameters('env'), variables('suffix'))]"
    },
    "keyVaultName": {
      "type": "string",
      "value": "[format('kv-{0}-{1}-{2}', parameters('project'), parameters('env'), variables('suffix'))]"
    },
    "searchEndpoint": {
      "type": "string",
      "value": "[format('https://{0}.search.windows.net', format('srch-{0}-{1}-{2}', parameters('project'), parameters('env'), variables('suffix')))]"
    },
    "openAiEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', format('oai-{0}-{1}-{2}', parameters('project'), parameters('env'), variables('suffix'))), '2023-05-01').endpoint]"
    },
    "postgresHost": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('pg-{0}-{1}-{2}', parameters('project'), parameters('env'), variables('suffix'))), '2023-12-01-preview').fullyQualifiedDomainName]"
    }
  }
}